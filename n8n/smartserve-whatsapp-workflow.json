  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "SmartServe AI - orchestrates WhatsApp message routing, voice transcription (Whisper) and image understanding (GPT-4o Vision) in n8n, then delegates menu/order/FAQ logic and conversation memory to the SmartServe backend via POST /api/n8n/process-message, and sends the reply back over the WhatsApp Cloud API.",
    "requiredCredentials": [
      "HTTP Header Auth credential named for Meta Graph API: header 'Authorization', value 'Bearer <WHATSAPP_ACCESS_TOKEN>'",
      "HTTP Header Auth credential named for OpenAI: header 'Authorization', value 'Bearer <OPENAI_API_KEY>'"
    ],
    "requiredEnvVars": ["WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "WHATSAPP_PHONE_NUMBER_ID", "WHATSAPP_API_VERSION", "OPENAI_API_KEY", "BACKEND_URL", "N8N_SHARED_SECRET"]
  }
}
