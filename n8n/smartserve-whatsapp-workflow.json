    "Transcribe Audio (Whisper)": { "main": [[{ "node": "Clean/Edit Transcript", "type": "main", "index": 0 }]] },
    "Clean/Edit Transcript": { "main": [[{ "node": "AI Agent (Backend: menu/order/faq tools + memory)", "type": "main", "index": 0 }]] },
    "Get Image Media URL": { "main": [[{ "node": "Download Image", "type": "main", "index": 0 }]] },
    "Download Image": { "main": [[{ "node": "Base64 Encode Image", "type": "main", "index": 0 }]] },
    "Base64 Encode Image": { "main": [[{ "node": "Analyze Image (GPT-4o Vision)", "type": "main", "index": 0 }]] },
